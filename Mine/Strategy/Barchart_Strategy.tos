declare upper;

# ============================================================
# Inputs
# ============================================================

input strategyType = {default PriceVsMA, MACross};
input signalType = {default Traditional, PriceConfirmed};

input fastLength = 20;
input slowLength = 50;

input showSignalDifferences = yes;


# ============================================================
# Moving averages
# ============================================================

def fastMA = Average(close, fastLength);
def slowMA = Average(close, slowLength);


# ============================================================
# Moving average plots
# ============================================================

plot FastMAPlot = fastMA;

plot SlowMAPlot =
    if strategyType == strategyType.MACross
    then slowMA
    else Double.NaN;

FastMAPlot.SetDefaultColor(Color.CYAN);
FastMAPlot.SetLineWeight(2);

SlowMAPlot.SetDefaultColor(Color.MAGENTA);
SlowMAPlot.SetLineWeight(2);


# ============================================================
# Price direction
# ============================================================
#
# Price confirmation requires an actual price move:
#
# BUY  -> today's close must be higher than yesterday's close
# SELL -> today's close must be lower than yesterday's close
#

def priceRising = close > close[1];
def priceFalling = close < close[1];


# ============================================================
# Traditional signals
# ============================================================
#
# PriceVsMA:
#   BUY  when close crosses above fast MA
#   SELL when close crosses below fast MA
#
# MACross:
#   BUY  when fast MA crosses above slow MA
#   SELL when fast MA crosses below slow MA
#

def traditionalBuy =
    if strategyType == strategyType.PriceVsMA
    then close crosses above fastMA
    else fastMA crosses above slowMA;

def traditionalSell =
    if strategyType == strategyType.PriceVsMA
    then close crosses below fastMA
    else fastMA crosses below slowMA;


# ============================================================
# Bullish / bearish regimes
# ============================================================
#
# These describe the CURRENT relationship rather than just
# detecting the bar on which the crossover occurred.
#
# This is important for PriceConfirmed mode because a crossover
# can occur without price moving in the appropriate direction.
# We can therefore wait for later price confirmation without
# losing the signal opportunity.
#

def bullishRegime =
    if strategyType == strategyType.PriceVsMA
    then close > fastMA
    else fastMA > slowMA;

def bearishRegime =
    if strategyType == strategyType.PriceVsMA
    then close < fastMA
    else fastMA < slowMA;


# ============================================================
# Price-confirmed state
# ============================================================
#
# confirmedState:
#
#   1  = confirmed bullish / BUY state
#  -1  = confirmed bearish / SELL state
#
# Example:
#
#   Day 1: price is above MA
#
#   Day 2: MA moves above price, but price did not fall.
#          Bearish regime exists, but NO SELL yet.
#
#   Day 3: price falls while still below MA.
#          SELL is now confirmed.
#
# This avoids both:
#
#   1. Trading merely because the MA moved past the price.
#
#   2. Missing the later signal because the crossover itself
#      occurred on an earlier bar.
#

rec confirmedState =
    if bullishRegime
       and priceRising
       and confirmedState[1] != 1
    then 1

    else if bearishRegime
            and priceFalling
            and confirmedState[1] != -1
    then -1

    else confirmedState[1];


# ============================================================
# Price-confirmed signals
# ============================================================
#
# Generate a signal only when confirmedState actually changes.
# This prevents repeated BUYs on every rising day above the MA
# and repeated SELLs on every falling day below the MA.
#

def confirmedBuy =
    confirmedState == 1
    and confirmedState[1] != 1;

def confirmedSell =
    confirmedState == -1
    and confirmedState[1] != -1;


# ============================================================
# Select strategy signal method
# ============================================================

def buySignal =
    if signalType == signalType.Traditional
    then traditionalBuy
    else confirmedBuy;

def sellSignal =
    if signalType == signalType.Traditional
    then traditionalSell
    else confirmedSell;


# ============================================================
# Strategy orders
# ============================================================
#
# Signal is determined using the completed current bar.
# The simulated trade occurs at the NEXT bar's open.
#

AddOrder(
    OrderType.BUY_AUTO,
    buySignal,
    open[-1],
    100,
    Color.GREEN,
    Color.GREEN,
    "BUY"
);

AddOrder(
    OrderType.SELL_AUTO,
    sellSignal,
    open[-1],
    100,
    Color.RED,
    Color.RED,
    "SELL"
);


# ============================================================
# Traditional vs PriceConfirmed comparison
# ============================================================
#
# YELLOW:
#   Traditional generated a signal on this bar but
#   PriceConfirmed did not.
#
# CYAN:
#   PriceConfirmed generated a signal on this bar but
#   Traditional did not.
#
# This makes it possible to see where price confirmation
# changes the timing or rejects a traditional signal.
#

def traditionalBuyOnly =
    traditionalBuy and !confirmedBuy;

def traditionalSellOnly =
    traditionalSell and !confirmedSell;

def confirmedBuyOnly =
    confirmedBuy and !traditionalBuy;

def confirmedSellOnly =
    confirmedSell and !traditionalSell;


# ============================================================
# Comparison plot offsets
# ============================================================
#
# Offset comparison arrows away from the candle so they do not
# overlap strategy order arrows or each other.
#
# ATR makes the distance appropriate for the volatility and
# price scale of the security being tested.
#

def arrowOffset = ATR(14) ; # * 0.35;


# ============================================================
# Comparison plots
# ============================================================

plot TraditionalBuyOnlyPlot =
    if showSignalDifferences and traditionalBuyOnly
    then low - (arrowOffset * 5)
    else Double.NaN;

plot TraditionalSellOnlyPlot =
    if showSignalDifferences and traditionalSellOnly
    then high + (arrowOffset * 5)
    else Double.NaN;

plot ConfirmedBuyOnlyPlot =
    if showSignalDifferences and confirmedBuyOnly
    then low - (arrowOffset * 2)
    else Double.NaN;

plot ConfirmedSellOnlyPlot =
    if showSignalDifferences and confirmedSellOnly
    then high + (arrowOffset * 2)
    else Double.NaN;


# Traditional-only = YELLOW

TraditionalBuyOnlyPlot.SetPaintingStrategy(
    PaintingStrategy.ARROW_UP
);
TraditionalBuyOnlyPlot.SetDefaultColor(Color.YELLOW);
TraditionalBuyOnlyPlot.SetLineWeight(3);

TraditionalSellOnlyPlot.SetPaintingStrategy(
    PaintingStrategy.ARROW_DOWN
);
TraditionalSellOnlyPlot.SetDefaultColor(Color.YELLOW);
TraditionalSellOnlyPlot.SetLineWeight(3);


# Confirmed-only = CYAN

ConfirmedBuyOnlyPlot.SetPaintingStrategy(
    PaintingStrategy.ARROW_UP
);
ConfirmedBuyOnlyPlot.SetDefaultColor(Color.CYAN);
ConfirmedBuyOnlyPlot.SetLineWeight(3);

ConfirmedSellOnlyPlot.SetPaintingStrategy(
    PaintingStrategy.ARROW_DOWN
);
ConfirmedSellOnlyPlot.SetDefaultColor(Color.CYAN);
ConfirmedSellOnlyPlot.SetLineWeight(3);

# ============================================================
# Strategy label
# ============================================================

AddLabel(
    yes,
    if strategyType == strategyType.PriceVsMA
    then
        "Price vs " + fastLength + "-D MA | " +
        (if signalType == signalType.Traditional
         then "Traditional"
         else "Price Confirmed")
    else
        fastLength + "-D vs " + slowLength + "-D MA X | " +
        (if signalType == signalType.Traditional
         then "Traditional"
         else "Price Confirmed"),
    Color.WHITE,
    Location.TOP_RIGHT,
    FontSize.SMALL,
    yes
);

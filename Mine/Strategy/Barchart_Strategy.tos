declare upper;

input strategyType = {default PriceVsMA, MACross};

input fastLength = 20;
input slowLength = 50;

# -------------------------
# Moving averages
# -------------------------

def fastMA = Average(close, fastLength);
def slowMA = Average(close, slowLength);


# -------------------------
# Moving average plots
# -------------------------

plot FastMAPlot = fastMA;

plot SlowMAPlot =
    if strategyType == strategyType.MACross
    then slowMA
    else Double.NaN;

FastMAPlot.SetDefaultColor(Color.CYAN);
FastMAPlot.SetLineWeight(2);

SlowMAPlot.SetDefaultColor(Color.MAGENTA);
SlowMAPlot.SetLineWeight(2);


# -------------------------
# Price direction
# -------------------------

def priceRising = close > close[1];
def priceFalling = close < close[1];


# -------------------------
# Trading regime
# -------------------------

def bullishRegime =
    if strategyType == strategyType.PriceVsMA
    then close > fastMA
    else fastMA > slowMA;

def bearishRegime =
    if strategyType == strategyType.PriceVsMA
    then close < fastMA
    else fastMA < slowMA;


# -------------------------
# Confirmed trading state
#
#  1 = BUY has been triggered for current bullish regime
# -1 = SELL has been triggered for current bearish regime
#
# A change of regime arms the opposite signal.
# The signal waits until price direction confirms it.
# -------------------------

rec tradeState =
    if bullishRegime and priceRising and tradeState[1] != 1
    then 1
    else if bearishRegime and priceFalling and tradeState[1] != -1
    then -1
    else tradeState[1];


# -------------------------
# Signals
# -------------------------

def buySignal =
    tradeState == 1 and tradeState[1] != 1;

def sellSignal =
    tradeState == -1 and tradeState[1] != -1;


# -------------------------
# Signal plot
# -------------------------
#
# plot signal =
#     if buySignal then 1
#     else if sellSignal then -1
#     else 0;
#
# signal.SetPaintingStrategy(PaintingStrategy.VALUES_BELOW);
#
# signal.AssignValueColor(
#     if signal > 0 then Color.GREEN
#     else if signal < 0 then Color.RED
#     else Color.CURRENT
# );


# -------------------------
# Strategy orders
# -------------------------

AddOrder(
    OrderType.BUY_AUTO,
    buySignal,
    open[-1],
    100,
    Color.GREEN,
    Color.GREEN,
    "BUY"
);

AddOrder(
    OrderType.SELL_AUTO,
    sellSignal,
    open[-1],
    100,
    Color.RED,
    Color.RED,
    "SELL"
);


# -------------------------
# Strategy label
# -------------------------

AddLabel(
    yes,
    if strategyType == strategyType.PriceVsMA
    then "Price vs " + fastLength + "-D MA Confirmed"
    else fastLength + "-D vs " + slowLength + "-D MA X Confirmed",
    Color.WHITE,
    Location.TOP_RIGHT,
    Fontsize.SMALL,
    yes
);
